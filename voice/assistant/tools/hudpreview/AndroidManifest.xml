<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="xyz.erapi0neer.hudpreview" android:versionCode="1" android:versionName="1.0">
 <!-- Off-screen samples of 星仪's panel from any source tree (a worker's worktree before merging), without touching the
