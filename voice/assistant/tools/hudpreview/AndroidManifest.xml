 <application android:label="星仪面板样张" android:hardwareAccelerated="false" android:allowBackup="false">
  <receiver android:name=".Render" android:exported="true" android:permission="android.permission.DUMP">
   <intent-filter><action android:name="xyz.erapi0neer.hudpreview.RENDER"/></intent-filter>
  </receiver>
 </application>
</manifest>
