{"11": {"1108": [{"year": "1226", "title": "法国卡佩王朝国王<a target=\"_blank\" href=\"https://baike.baidu.com/item/%E8%B7%AF%E6%98%93%E5%85%AB%E4%B8%96\">路易八世</a>逝世", "festival": "", "link": "https://baike.baidu.com/item/%E8%B7%AF%E6%98%93%E5%85%AB%E4%B8%96", "type": "death", "desc": "路易八世（狮子）Louis VIII le Lion（1187年9月5日—1226年11月8日）法国卡佩王朝国王（1223年—1226年在位）。", "cover": false, "recommend": true}, {"year": "1793", "title": "法国大革命时期政治家<a target=\"_blank\" href=\"https://baike.baidu.com/item/%E7%BD%97%E5%85%B0%E5%A4%AB%E4%BA%BA\">罗兰夫人</a>逝世", "festival": "", "link": "https://baike.baidu.com/item/%E7%BD%97%E5%85%B0%E5%A4%AB%E4%BA%BA", "type": "death", "desc": "<a target=\"_blank\" href=\"https://baike.baidu.com/item/%E7%BD%97%E5%85%B0\">罗兰</a>夫人（Manon Jeanne Phlipon，1754年3月17日-1793年11月8日），法国大革命时期著名的<a target=\"_blank\" href=\"https://baike.baidu.com/item/%E6%94%BF%E6%B2%BB%E5%AE%B6\">政治家</a>。吉伦特党<a target=\"_blank\" href=\"https://baike.baidu.com/item/%E9%A2%86%E5%AF%BC\">领导</a>人之一。", "cover": false, "recommend": false}, {"year": "1875", "title": "中国女革命军、女权思想的倡导者<a target=\"_blank\" href=\"https://baike.baidu.com/item/%E7%A7%8B%E7%91%BE/30055\">秋瑾</a>出生", "festival": "", "link": "https://baike.baidu.com/item/%E7%A7%8B%E7%91%BE/30055", "type": "birth", "desc": "秋瑾是我国近代杰出的革命家和妇女解放运动的先驱。她依父母之命嫁给富绅子弟王廷钧，最终冲破家庭阻力投身革命。她与徐锡麟策划皖浙同时起义，却因奸人告密清政府而被捕就义。", "cover": true, "recommend": true, "pic_calendar": "http://baike.bdimg.com/cms/rc/r/image/2014-08-31/c605a63e92c0346beff452259fc1f197_80_80.jpg", "pic_share": "http://baike.bdimg.com/cms/rc/r/image/2014-08-31/ce178a79c5a384b3b6fa4e9d990f8b92_360_212.jpg", "pic_index": "http://baike.bdimg.com/cms/rc/r/image/2014-08-31/f53b675091fadaa030e9d771d46f9826_134_100.jpg"}, {"year": "1895", "title": "德国物理学家<a target=\"_blank\" href=\"https://baike.baidu.com/item/%E5%A8%81%E5%BB%89%C2%B7%E5%BA%B7%E6%8B%89%E5%BE%B7%C2%B7%E4%BC%A6%E7%90%B4\">威廉·康拉德·伦琴</a>首次发现X射线", "festival": "", "link": "https://baike.baidu.com/item/%E5%A8%81%E5%BB%89%C2%B7%E5%BA%B7%E6%8B%89%E5%BE%B7%C2%B7%E4%BC%A6%E7%90%B4", "type": "event", "desc": "德国物理学家，发现了X射线，为开创医疗影像技术铺平了道路。1901年被授予首次诺贝尔物理学奖。", "cover": false, "recommend": true}, {"year": "1901", "title": "中华人民共和国十大元帅之一<a target=\"_blank\" href=\"https://baike.baidu.com/item/%E5%BE%90%E5%90%91%E5%89%8D\">徐向前</a>出生", "festival": "", "link": "https://baike.baidu.com/item/%E5%BE%90%E5%90%91%E5%89%8D", "type": "event", "desc": "徐向前，中国共产党的优秀党员，久经考验的无产阶级革命家、军事家，忠诚的共产主义战士。", "cover": false, "recommend": false}, {"year": "1923", "title": "<a target=\"_blank\" href=\"https://baike.baidu.com/item/%E5%95%A4%E9%85%92%E9%A6%86%E6%9A%B4%E5%8A%A8\">啤酒馆暴动</a>", "festival": "", "link": "https://baike.baidu.com/item/%E5%95%A4%E9%85%92%E9%A6%86%E6%9A%B4%E5%8A%A8", "type": "event", "desc": "1923年11月A.希特勒和E.鲁登道夫等人在慕尼黑发动的<a target=\"_blank\" href=\"https://baike.baidu.com/item/%E6%B3%95%E8%A5%BF%E6%96%AF\">法西斯</a>未遂政变。", "cover": false, "recommend": false}, {"year": "1924", "title": "苏联元帅<a target=\"_blank\" href=\"https://baike.baidu.com/item/%E5%BE%B7%E7%B1%B3%E7%89%B9%E9%87%8C%C2%B7%E8%8E%AB%E8%8F%B2%E8%80%B6%E7%BB%B4%E5%A5%87%C2%B7%E4%BA%9A%E4%BD%90%E5%A4%AB\">德米特里·莫菲耶维奇·亚佐夫</a>出生", "festival": "", "link": "https://baike.baidu.com/item/%E5%BE%B7%E7%B1%B3%E7%89%B9%E9%87%8C%C2%B7%E8%8E%AB%E8%8F%B2%E8%80%B6%E7%BB%B4%E5%A5%87%C2%B7%E4%BA%9A%E4%BD%90%E5%A4%AB", "type": "birth", "desc": "德米特里·莫菲耶维奇·亚佐  <a target=\"_blank\" href=\"https://baike.baidu.com/item/%E8%8B%8F%E8%81%94\">苏联</a>国防部长、<a target=\"_blank\" href=\"https://baike.baidu.com/item/%E8%8B%8F%E8%81%94%E5%85%83%E5%B8%85\">苏联元帅</a>。", "cover": false, "recommend": false}, {"year": "1931", "title": "日本策划<a target=\"_blank\" href=\"https://baike.baidu.com/item/%E5%A4%A9%E6%B4%A5%E4%BA%8B%E5%8F%98\">便衣队暴乱</a>", "festival": "", "link": "https://baike.baidu.com/item/%E5%A4%A9%E6%B4%A5%E4%BA%8B%E5%8F%98", "type": "event", "desc": "1931年11月8日，<a target=\"_blank\" href=\"https://baike.baidu.com/item/%E6%97%A5%E6%9C%AC\">日本</a>侵略者在<a target=\"_blank\" href=\"https://baike.baidu.com/item/%E5%A4%A9%E6%B4%A5\">天津</a>纠集一伙乌合之众，制造了一起武装暴乱事件，史称“天津事变”。", "cover": false, "recommend": false}, {"year": "1937", "title": "中华民国国民革命军将领<a target=\"_blank\" href=\"https://baike.baidu.com/item/%E5%88%98%E5%90%AF%E6%96%87/3410692\">刘启文</a>逝世", "festival": "", "link": "https://baike.baidu.com/item/%E5%88%98%E5%90%AF%E6%96%87/3410692", "type": "death", "desc": "刘启文（1899年—1937年11月），男，汉族，字靖远，河南省南阳市淅川县人，抗日民族英雄，爱国将领，1912年考入天津南开中学，1921年考入保定陆军大学第七期，1937年被任命为国民革命军（又称中央军）第67军108师322旅长，少将军衔。", "cover": false, "recommend": false}, {"year": "1966", "title": "香港电讯盈科主席、富商李嘉诚之子\n<a target=\"_blank\" href=\"https://baike.baidu.com/item/%E6%9D%8E%E6%B3%BD%E6%A5%B7\">李泽楷</a>出生", "festival": "", "link": "https://baike.baidu.com/item/%E6%9D%8E%E6%B3%BD%E6%A5%B7", "type": "birth", "desc": "李泽楷是<a target=\"_blank\" href=\"https://baike.baidu.com/item/%E9%A6%99%E6%B8%AF\">香港</a>富商<a target=\"_blank\" href=\"https://baike.baidu.com/item/%E6%9D%8E%E5%98%89%E8%AF%9A\">李嘉诚</a>之子。", "cover": false, "recommend": true}, {"year": "1973", "title": "中国歌手<a target=\"_blank\" href=\"https://baike.baidu.com/item/%E6%9C%B4%E6%A0%91/7599\">朴树</a>出生", "festival": "", "link": "https://baike.baidu.com/item/%E6%9C%B4%E6%A0%91/7599", "type": "birth", "desc": "朴树，本名濮树，1973年11月8日出生于江苏南京，中国内地男歌手。1994年放弃首都师范大学学业，开始音乐创作。", "cover": false, "recommend": false}, {"year": "1997", "title": "<a target=\"_blank\" href=\"https://baike.baidu.com/item/%E9%95%BF%E6%B1%9F%E4%B8%89%E5%B3%A1\">长江三峡</a>大江截流成功完成", "festival": "", "link": "https://baike.baidu.com/item/%E9%95%BF%E6%B1%9F%E4%B8%89%E5%B3%A1", "type": "event", "desc": "长江三峡西起奉节<a target=\"_blank\" href=\"https://baike.baidu.com/item/%E7%99%BD%E5%B8%9D%E5%9F%8E/25893\">白帝城</a>，东至湖北宜昌<a target=\"_blank\" href=\"https://baike.baidu.com/item/%E5%8D%97%E6%B4%A5%E5%85%B3\">南津关</a>，全长193千米。", "cover": false, "recommend": true}, {"year": "1997", "title": "法国文学翻译家<a target=\"_blank\" href=\"https://baike.baidu.com/item/%E9%97%BB%E5%AE%B6%E9%A9%B7\">闻家驷</a>逝世", "festival": "", "link": "https://baike.baidu.com/item/%E9%97%BB%E5%AE%B6%E9%A9%B7", "type": "death", "desc": "闻家驷，原名闻籍，湖北浠水人，著名法国文学专家、翻译家。著名诗人、学者、民主斗士闻一多先生的胞弟。", "cover": false, "recommend": false}, {"year": "2009", "title": "俄罗斯著名物理学家<a target=\"_blank\" href=\"https://baike.baidu.com/item/%E7%BB%B4%E5%A1%94%E5%88%A9%C2%B7%E9%87%91%E8%8C%A8%E5%A0%A1\">维塔利·金茨堡</a>逝世", "festival": "", "link": "https://baike.baidu.com/item/%E7%BB%B4%E5%A1%94%E5%88%A9%C2%B7%E9%87%91%E8%8C%A8%E5%A0%A1", "type": "death", "desc": "英文翻译为金兹伯格，<a target=\"_blank\" href=\"https://baike.baidu.com/item/%E7%89%A9%E7%90%86%E5%AD%A6%E5%AE%B6\">物理学家</a>，苏联科学院院士。", "cover": false, "recommend": false}], "1107": [{"year": "1867", "title": "被称为居里夫人的<a target=\"_blank\" href=\"https://baike.baidu.com/item/%E7%8E%9B%E4%B8%BD%C2%B7%E5%B1%85%E9%87%8C\">玛丽亚·斯克沃多夫斯卡·居里</a>出生", "festival": "", "link": "https://baike.baidu.com/item/%E7%8E%9B%E4%B8%BD%C2%B7%E5%B1%85%E9%87%8C", "type": "birth", "desc": "玛丽亚·斯克沃多夫斯卡·居里（1867~1934）， 原籍<a target=\"_blank\" href=\"https://baike.baidu.com/item/%E6%B3%A2%E5%85%B0/421640\">波兰</a>，<a target=\"_blank\" href=\"https://baike.baidu.com/item/%E6%B3%95%E5%9B%BD\">法国</a>著名科学家、<a target=\"_blank\" href=\"https://baike.baidu.com/item/%E7%89%A9%E7%90%86%E5%AD%A6%E5%AE%B6/2353\">物理学家</a>、<a target=\"_blank\" href=\"https://baike.baidu.com/item/%E5%8C%96%E5%AD%A6\">化学</a>家。", "cover": false, "recommend": true}, {"year": "1879", "title": "苏联第四国际领袖<a target=\"_blank\" href=\"https://baike.baidu.com/item/%E5%88%97%E5%A4%AB%C2%B7%E8%BE%BE%E7%BB%B4%E5%A4%9A%E7%BB%B4%E5%A5%87%C2%B7%E6%89%98%E6%B4%9B%E8%8C%A8%E5%9F%BA/81021\">列夫·达维多维奇·托洛茨基</a>出生", "festival": "", "link": "https://baike.baidu.com/item/%E5%88%97%E5%A4%AB%C2%B7%E8%BE%BE%E7%BB%B4%E5%A4%9A%E7%BB%B4%E5%A5%87%C2%B7%E6%89%98%E6%B4%9B%E8%8C%A8%E5%9F%BA/81021", "type": "birth", "desc": "列夫·达维多维奇·托洛茨基（俄语：Лев Дави́дович Тро́цкий，1879年11月7日-1940年8月21日），原名列夫·达维多维奇·勃朗施坦，苏联无产阶级革命家、政治家、军事家、理论家，苏联红军、第四国际的主要缔造者。", "cover": false, "recommend": true}, {"year": "1895", "title": "中国革命家<a target=\"_blank\" href=\"https://baike.baidu.com/item/%E9%99%86%E7%9A%93%E4%B8%9C\">陆皓东</a>逝世", "festival": "", "link": "https://baike.baidu.com/item/%E9%99%86%E7%9A%93%E4%B8%9C", "type": "death", "desc": "陆皓东（1868-1895），名中桂，字献香，广东<a target=\"_blank\" href=\"https://baike.baidu.com/item/%E9%A6%99%E5%B1%B1%E5%8E%BF\">香山县</a><a target=\"_blank\" href=\"https://baike.baidu.com/item/%E7%BF%A0%E4%BA%A8%E6%9D%91/54923\">翠亨村</a>人（今<a target=\"_blank\" href=\"https://baike.baidu.com/item/%E4%B8%AD%E5%B1%B1%E5%B8%82\">中山市</a><a target=\"_blank\" href=\"https://baike.baidu.com/item/%E5%8D%97%E6%9C%97%E9%95%87\">南朗镇</a>翠亨村人）。", "cover": false, "recommend": false}, {"year": "1901", "title": "晚清政治家<a target=\"_blank\" href=\"https://baike.baidu.com/item/%E6%9D%8E%E9%B8%BF%E7%AB%A0/28575\">李鸿章</a>逝世", "festival": "", "link": "https://baike.baidu.com/item/%E6%9D%8E%E9%B8%BF%E7%AB%A0/28575", "type": "death", "desc": "李鸿章（1823年2月15日—1901年11月7日），晚清名臣，<a target=\"_blank\" href=\"https://baike.baidu.com/item/%E6%B4%8B%E5%8A%A1%E8%BF%90%E5%8A%A8\">洋务运动</a>的主要领导人之一，安徽合肥人，世人多尊称李中堂，亦称李合肥，中国晚清时期政治家、外交家、军事将领。", "cover": false, "recommend": true}, {"year": "1910", "title": "俄国伟大作家<a target=\"_blank\" href=\"https://baike.baidu.com/item/%E5%88%97%E5%A4%AB%C2%B7%E5%B0%BC%E5%8F%A4%E6%8B%89%E8%80%B6%E7%BB%B4%E5%A5%87%C2%B7%E6%89%98%E5%B0%94%E6%96%AF%E6%B3%B0/1250657\">列夫·托尔斯泰</a>逝世", "festival": "", "link": "https://baike.baidu.com/item/%E5%88%97%E5%A4%AB%C2%B7%E5%B0%BC%E5%8F%A4%E6%8B%89%E8%80%B6%E7%BB%B4%E5%A5%87%C2%B7%E6%89%98%E5%B0%94%E6%96%AF%E6%B3%B0/1250657", "type": "death", "desc": "19世纪中期俄国<a target=\"_blank\" href=\"https://baike.baidu.com/item/%E6%89%B9%E5%88%A4%E7%8E%B0%E5%AE%9E%E4%B8%BB%E4%B9%89\">批判现实主义</a>作家、<a target=\"_blank\" href=\"https://baike.baidu.com/item/%E6%96%87%E5%AD%A6%E5%AE%B6\">文学家</a>、<a target=\"_blank\" href=\"https://baike.baidu.com/item/%E6%80%9D%E6%83%B3%E5%AE%B6\">思想家</a>，<a target=\"_blank\" href=\"https://baike.baidu.com/item/%E5%93%B2%E5%AD%A6%E5%AE%B6\">哲学家</a>。世袭伯爵，曾参加<a target=\"_blank\" href=\"https://baike.baidu.com/item/%E5%85%8B%E9%87%8C%E7%B1%B3%E4%BA%9A%E6%88%98%E4%BA%89\">克里米亚战争</a>。", "cover": false, "recommend": false}, {"year": "1914", "title": "一战，驻守<a target=\"_blank\" href=\"https://baike.baidu.com/item/%E9%9D%92%E5%B2%9B\">青岛</a>的德军向日军投降", "festival": "", "link": "https://baike.baidu.com/item/%E9%9D%92%E5%B2%9B", "type": "event", "desc": "青岛市（英文名：Qingdao City），山东省辖地级市，简称“青”，别名“岛城”“琴岛”，为副省级市、计划单列市，青岛市地处山东半岛南部，东、南濒临黄海，东北与烟台市毗邻，西与潍坊市相连，西南与日照市接壤，全市总面积为11293平方千米。", "cover": false, "recommend": false}, {"year": "1915", "title": "中国外交家<a target=\"_blank\" href=\"https://baike.baidu.com/item/%E9%99%88%E8%BE%9B%E4%BB%81\">陈辛仁</a>出生", "festival": "", "link": "https://baike.baidu.com/item/%E9%99%88%E8%BE%9B%E4%BB%81", "type": "birth", "desc": "陈辛仁（1915.11.7－－2005.7.25）左翼作家。笔名辛人，广东<a target=\"_blank\" href=\"https://baike.baidu.com/item/%E6%99%AE%E5%AE%81%E5%8E%BF\">普宁县</a>人。北平中国大学学生，中国左翼作家联盟北方部成员。", "cover": false, "recommend": true}, {"year": "1917", "title": "<a target=\"_blank\" href=\"https://baike.baidu.com/item/%E5%8D%81%E6%9C%88%E9%9D%A9%E5%91%BD/468\">十月革命</a>爆发", "festival": "", "link": "https://baike.baidu.com/item/%E5%8D%81%E6%9C%88%E9%9D%A9%E5%91%BD/468", "type": "event", "desc": "1917年11月7日，列宁和托洛茨基领导的布尔什维克武装力量向资产阶级临时政府所在地圣彼得堡冬宫发起总攻，推翻了临时政府，建立了苏维埃政权。", "cover": false, "recommend": false}, {"year": "1918", "title": "德国<a target=\"_blank\" href=\"https://baike.baidu.com/item/%E6%85%95%E5%B0%BC%E9%BB%91/855\">慕尼黑</a>爆发起义", "festival": "", "link": "https://baike.baidu.com/item/%E6%85%95%E5%B0%BC%E9%BB%91/855", "type": "event", "desc": "慕尼黑（德语：München，英语：Munich）建于1158年，位于德意志联邦共和国南部，阿尔卑斯山北麓，是德国主要的经济、文化、科技和交通中心之一。慕尼黑是德国第三大城市，德国南部第一大城市。", "cover": false, "recommend": false}, {"year": "1926", "title": "被誉为“世纪最佳嗓音”的<a target=\"_blank\" href=\"https://baike.baidu.com/item/%E7%90%BC%C2%B7%E8%90%A8%E7%91%9F%E5%85%B0\">琼·萨瑟兰</a>出生", "festival": "", "link": "https://baike.baidu.com/item/%E7%90%BC%C2%B7%E8%90%A8%E7%91%9F%E5%85%B0", "type": "birth", "desc": "琼·萨瑟兰是澳大利亚歌剧女高音歌唱家。她嗓音清亮剔透，华美淳厚，被公认为花腔艺术的典范。她曾在米兰丝卡拉歌剧院演出《拉美莫尔的露茜亚》时引起轰动，谢幕多达30次，一夜成名。", "cover": true, "recommend": true, "pic_calendar": "http://baike.bdimg.com/cms/rc/r/image/2014-08-31/447e980919e3277578ea7361ede7aa2f_80_80.jpg", "pic_share": "http://baike.bdimg.com/cms/rc/r/image/2014-08-31/935987910c51b60e93bbc08a5424f0b3_360_212.jpg", "pic_index": "http://baike.bdimg.com/cms/rc/r/image/2014-08-31/3089112061dfd30532b5c97bc5d0de41_134_100.jpg"}, {"year": "1927", "title": "日本任天堂顾问<a target=\"_blank\" href=\"https://baike.baidu.com/item/%E5%B1%B1%E5%86%85%E6%BA%A5\">山内溥</a>出生", "festival": "", "link": "https://baike.baidu.com/item/%E5%B1%B1%E5%86%85%E6%BA%A5", "type": "birth", "desc": "山内溥（やまうち ひろし，1927年11月7日～2013年9月19日），出生于日本京都，出生时名字为山内博。日本企业家、任天堂游戏制作公司顾问、前总裁。毕业于日本私立第一学府早稻田大学。管理任天堂超过50年之久，游戏界教父级人物。", "cover": false, "recommend": false}, {"year": "1992", "title": "捷克政治家<a target=\"_blank\" href=\"https://baike.baidu.com/item/%E4%BA%9A%E5%8E%86%E5%B1%B1%E5%A4%A7%C2%B7%E6%9D%9C%E5%B8%83%E5%88%87%E5%85%8B\">亚历山大·杜布切克</a>逝世", "festival": "", "link": "https://baike.baidu.com/item/%E4%BA%9A%E5%8E%86%E5%B1%B1%E5%A4%A7%C2%B7%E6%9D%9C%E5%B8%83%E5%88%87%E5%85%8B", "type": "death", "desc": "亚历山大·杜布切克（Alexander Dubček，1921年11月27日—1992年11月7日），<a target=\"_blank\" href=\"https://baike.baidu.com/item/%E6%8D%B7%E5%85%8B\">捷克</a>的政治家，<a target=\"_blank\" href=\"https://baike.baidu.com/item/%E5%B8%83%E6%8B%89%E6%A0%BC%E4%B9%8B%E6%98%A5\">布拉格之春</a>的领导人。", "cover": false, "recommend": false}], "1106": [{"year": "1494", "title": "奥斯曼帝国君王<a target=\"_blank\" href=\"https://baike.baidu.com/item/%E8%8B%8F%E8%8E%B1%E6%9B%BC%E4%B8%80%E4%B8%96\">苏莱曼一世</a>出生", "festival": "", "link": "https://baike.baidu.com/item/%E8%8B%8F%E8%8E%B1%E6%9B%BC%E4%B8%80%E4%B8%96", "type": "birth", "desc": "苏莱曼一世（奥斯曼土耳其文：سليمان اول、现代土耳其文：Suleiman the Magnificent；1494年11月6日—1566年9月7日），是奥斯曼帝国第10位苏丹，也是在位时间最长的苏丹（1520年—156