{
 "id": "loop-fixes",
 "title": "A long download is not 「太复杂」; 「关闭屏幕」 said truly; one installer search per app",
 "brief": "briefs/loop-fixes.md",
 "isolation": "worktree",
 "maxRounds": 5,
 "timeoutMin": 100,
 "owns": [
  "src/xyz/erapi0neer/xingyi/agent/AgentLoop.java",
  "src/xyz/erapi0neer/xingyi/agent/QuickCommand.java",
  "src/xyz/erapi0neer/xingyi/agent/InstallerCache.java",
  "src/xyz/erapi0neer/xingyi/agent/tv/TvTools.java",
  "tests/agent/LoopFixChecks.java"
 ],
 "accept": [
  {
   "name": "core-checks",
   "cmd": "sh tests/agent/run_core.sh",
   "timeoutS": 400,
   "must": [
    "re:agent core: (316[7-9]|31[7-9]\\d|3[2-9]\\d\\d|[4-9]\\d{3}) passed, 0 failed"
   ]
  },
  {
   "name": "android-check",
   "cmd": "sh tests/agent/android_check.sh",
   "timeoutS": 300,
   "must": [
    "ANDROID CHECK OK"
   ]
  },
  {
   "name": "build-and-api",
   "cmd": "sh tests/agent/accept_loop_fixes.sh",
   "timeoutS": 900,
   "must": [
    "LOOP FIXES OK"
   ]
  }
 ]
}
