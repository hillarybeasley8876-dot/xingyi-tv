{
 "id": "verify-wait",
 "title": "场景说等20分钟再来，工具等，不该是人等",
 "brief": "briefs/verify-wait.md",
 "isolation": "worktree",
 "maxRounds": 6,
 "timeoutMin": 70,
 "owns": [
  "tests/agent/verify.sh",
  "tests/agent/accept_verify_durable.sh"
 ],
 "accept": [
  {
   "name": "core-checks",
   "cmd": "sh tests/agent/run_core.sh",
   "timeoutS": 500,
   "must": [
    "re:agent core: ([1-9]\\d{4,}|569[6-9]|5[7-9]\\d\\d|[6-9]\\d\\d\\d) passed, 0 failed"
   ]
  },
  {
   "name": "android-check",
   "cmd": "sh tests/agent/android_check.sh",
   "timeoutS": 400,
   "must": [
    "ANDROID CHECK OK"
   ]
  },
  {
   "name": "bridge",
   "cmd": "sh tests/agent/accept_verify_durable.sh",
   "timeoutS": 900,
   "must": [
    "VERIFY DURABLE OK"
   ]
  }
 ]
}
