{
 "id": "app-compile",
 "title": "An app the system could not compile (B站: 61 s to its first page) is compiled by the guard in standby",
 "brief": "briefs/app-compile.md",
 "isolation": "worktree",
 "maxRounds": 5,
 "timeoutMin": 100,
 "owns": [
  "src/xyz/erapi0neer/xingyi/agent/AppCompile.java",
  "src/xyz/erapi0neer/xingyi/agent/tv/MemoryGuard.java",
  "tests/agent/MemoryCareChecks.java"
 ],
 "accept": [
  { "name": "core-checks", "cmd": "sh tests/agent/run_core.sh", "timeoutS": 500,
    "must": ["re:agent core: (40(59|[6-9]\\d)|4[1-9]\\d\\d|[5-9]\\d{3}) passed, 0 failed"] },
  { "name": "android-check", "cmd": "sh tests/agent/android_check.sh", "timeoutS": 400, "must": ["ANDROID CHECK OK"] },
  { "name": "bridge", "cmd": "sh tests/agent/accept_app_compile.sh", "timeoutS": 900, "must": ["APP COMPILE OK"] }
 ]
}
