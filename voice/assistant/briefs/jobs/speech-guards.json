{
 "id": "speech-guards",
 "title": "An answer never says itself twice, and never ends on 要不我…？",
 "brief": "briefs/speech-guards.md",
 "isolation": "worktree",
 "maxRounds": 5,
 "timeoutMin": 90,
 "owns": [
  "src/xyz/erapi0neer/xingyi/agent/Speech.java",
  "src/xyz/erapi0neer/xingyi/agent/AgentLoop.java",
  "tests/agent/OfferChecks.java",
  "PROMPTS.md"
 ],
 "accept": [
  {
   "name": "core-checks",
   "cmd": "sh tests/agent/run_core.sh",
   "timeoutS": 500,
   "must": [
    "re:agent core: (38(29|[3-9]\\d)|39\\d\\d|[4-9]\\d{3}) passed, 0 failed"
   ]
  },
  {
   "name": "android-check",
   "cmd": "sh tests/agent/android_check.sh",
   "timeoutS": 400,
   "must": [
    "ANDROID CHECK OK"
   ]
  },
  {
   "name": "prompts-doc",
   "cmd": "python tests/agent/prompts_doc.py --check",
   "timeoutS": 120,
   "must": [
    "PROMPTS.md is up to date"
   ]
  }
 ]
}
