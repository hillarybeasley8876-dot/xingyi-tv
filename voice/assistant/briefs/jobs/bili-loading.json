  { "name": "android-check", "cmd": "sh tests/agent/android_check.sh", "timeoutS": 400, "must": ["ANDROID CHECK OK"] },
  { "name": "prompts-doc", "cmd": "python tests/agent/prompts_doc.py --check", "timeoutS": 120, "must": ["PROMPTS.md is up to date"] },
  { "name": "bridge", "cmd": "sh tests/agent/accept_bili_loading.sh", "timeoutS": 900, "must": ["BILI LOADING OK"] }
 ]
}
