{
 "id": "panel-design",
 "title": "The panel typeset with care, and the thinking chain shown under the step it belongs to",
 "brief": "briefs/panel-design.md",
 "isolation": "worktree",
 "maxRounds": 5,
 "timeoutMin": 110,
 "owns": [
  "src/xyz/erapi0neer/xingyi/agent/tv/Hud.java",
  "src/xyz/erapi0neer/xingyi/agent/tv/AgentDebug.java",
  "src/xyz/erapi0neer/xingyi/agent/tv/AgentEngine.java"
 ],
 "accept": [
  {
   "name": "core-checks",
   "cmd": "sh tests/agent/run_core.sh",
   "timeoutS": 400,
   "must": [
    "re:agent core: (315[5-9]|31[6-9]\\d|3[2-9]\\d\\d|[4-9]\\d{3}) passed, 0 failed"
   ]
  },
  {
   "name": "android-check",
   "cmd": "sh tests/agent/android_check.sh",
   "timeoutS": 300,
   "must": [
    "ANDROID CHECK OK"
   ]
  },
  {
   "name": "build-and-api",
   "cmd": "sh tests/agent/accept_panel_design.sh",
   "timeoutS": 900,
   "must": [
    "PANEL DESIGN OK"
   ]
  }
 ]
}
