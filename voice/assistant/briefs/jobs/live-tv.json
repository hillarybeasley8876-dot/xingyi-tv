   "timeoutS": 400,
   "must": [
    "ANDROID CHECK OK"
   ]
  },
  {
   "name": "bridge",
   "cmd": "sh tests/agent/accept_live_tv.sh",
   "timeoutS": 900,
   "must": [
    "LIVE TV OK"
   ]
  }
 ]
}
