{
 "id": "app-exit",
 "title": "「退出网易云」 leaves the app for the home in one step (media_control exit + quick command)",
 "brief": "briefs/app-exit.md",
 "isolation": "worktree",
 "maxRounds": 5,
 "timeoutMin": 100,
 "owns": [
  "src/xyz/erapi0neer/xingyi/agent/tv/TvTools.java",
  "src/xyz/erapi0neer/xingyi/agent/QuickCommand.java",
  "tests/agent/QuickChecks.java"
 ],
 "accept": [
  {
   "name": "core-checks",
   "cmd": "sh tests/agent/run_core.sh",
   "timeoutS": 400,
   "must": [
    "re:agent core: (338[6-9]|339\\d|3[4-9]\\d\\d|[4-9]\\d{3}) passed, 0 failed"
   ]
  },
  {
   "name": "android-check",
   "cmd": "sh tests/agent/android_check.sh",
   "timeoutS": 300,
   "must": [
    "ANDROID CHECK OK"
   ]
  },
  {
   "name": "build-and-pieces",
   "cmd": "sh tests/agent/accept_app_exit.sh",
   "timeoutS": 900,
   "must": [
    "APP EXIT OK"
   ]
  }
 ]
}
