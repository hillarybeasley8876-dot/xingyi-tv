   "timeoutS": 300,
   "must": ["ANDROID CHECK OK"]
  },
  {
   "name": "tv-build-and-wiring",
   "cmd": "sh tests/agent/accept_tv_wiring.sh",
   "timeoutS": 900,
   "must": ["WIRING OK"]
  }
 ]
}
