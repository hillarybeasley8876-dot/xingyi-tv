 "brief": "briefs/watch-quick.md",
 "isolation": "worktree",
 "maxRounds": 6,
 "timeoutMin": 110,
 "owns": [
  "src/xyz/erapi0neer/xingyi/agent/Feeds.java",
  "src/xyz/erapi0neer/xingyi/agent/TencentVideo.java",
  "src/xyz/erapi0neer/xingyi/agent/QuickCommand.java",
  "src/xyz/erapi0neer/xingyi/agent/tv/TvTools.java",
