{
 "id": "cards-data",
 "title": "The data tools hand the panel a card; the card travels on the ledger to the panel",
 "brief": "briefs/cards-data.md",
 "isolation": "worktree",
 "maxRounds": 5,
 "timeoutMin": 110,
 "owns": [
  "src/xyz/erapi0neer/xingyi/agent/Cards.java",
  "src/xyz/erapi0neer/xingyi/agent/Weather.java",
  "src/xyz/erapi0neer/xingyi/agent/Ledger.java",
  "src/xyz/erapi0neer/xingyi/agent/AgentLoop.java",
  "src/xyz/erapi0neer/xingyi/agent/tv/TvTools.java",
  "src/xyz/erapi0neer/xingyi/agent/tv/AgentEngine.java",
  "tests/agent/CardChecks.java"
 ],
 "accept": [
  {
   "name": "core-checks",
   "cmd": "sh tests/agent/run_core.sh",
   "timeoutS": 400,
   "must": [
    "re:agent core: (271[2-9]|27[2-9]\\d|2[89]\\d\\d|[3-9]\\d{3}) passed, 0 failed"
   ]
  },
  {
   "name": "android-check",
   "cmd": "sh tests/agent/android_check.sh",
   "timeoutS": 300,
   "must": [
    "ANDROID CHECK OK"
   ]
  },
  {
   "name": "build-and-api",
   "cmd": "sh tests/agent/accept_cards_data.sh",
   "timeoutS": 900,
   "must": [
    "CARDS DATA OK"
   ]
  }
 ]
}
