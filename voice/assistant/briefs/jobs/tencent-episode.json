    "re:agent core: ([1-9]\\d{4,}|472[4-9]|47[3-9]\\d|4[8-9]\\d\\d|[5-9]\\d\\d\\d) passed, 0 failed"
   ]
  },
  {
   "name": "android-check",
   "cmd": "sh tests/agent/android_check.sh",
   "timeoutS": 400,
   "must": [
    "ANDROID CHECK OK"
   ]
  },
  {
   "name": "bridge",
   "cmd": "sh tests/agent/accept_tencent_episode.sh",
   "timeoutS": 900,
   "must": [
    "TENCENT EPISODE OK"
   ]
  }
 ]
}
