{
 "id": "realpath-evidence",
 "title": "真机证据要能被检查器看见：evidence/realpath/ 里的五份没有一条检查得到，把场景补齐并搬回 evidence/ 根下",
 "brief": "briefs/realpath-evidence.md",
 "isolation": "worktree",
 "maxRounds": 6,
 "timeoutMin": 80,
 "owns": [
  "tests/agent/realpath/check.py",
  "tests/agent/realpath/scenarios/",
  "tests/agent/realpath/scenarios.json",
  "tests/agent/RealPathChecks.java",
  "tests/agent/accept_real_path.sh"
 ],
 "accept": [
  {
   "name": "core-checks",
   "cmd": "sh tests/agent/run_core.sh",
   "timeoutS": 500,
   "must": [
    "re:agent core: ([1-9]\\d{4,}|562[4-9]|56[3-9]\\d|5[7-9]\\d\\d|[6-9]\\d\\d\\d) passed, 0 failed"
   ]
  },
  {
   "name": "android-check",
   "cmd": "sh tests/agent/android_check.sh",
   "timeoutS": 400,
   "must": [
    "ANDROID CHECK OK"
   ]
  },
  {
   "name": "bridge",
   "cmd": "sh tests/agent/accept_real_path.sh",
   "timeoutS": 900,
   "must": [
    "REALPATH OK"
   ]
  }
 ]
}
