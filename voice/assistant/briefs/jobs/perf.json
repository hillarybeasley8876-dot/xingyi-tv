{
 "id": "perf",
 "title": "Perf: a cacheable prompt, a timing trace for every task, B站 started while the model plans",
 "brief": "briefs/perf.md",
 "isolation": "worktree",
 "maxRounds": 5,
 "timeoutMin": 110,
 "owns": [
  "src/xyz/erapi0neer/xingyi/agent/AgentLoop.java",
  "src/xyz/erapi0neer/xingyi/agent/Perf.java",
  "src/xyz/erapi0neer/xingyi/agent/tv/AgentEngine.java",
  "tests/agent/PerfChecks.java"
 ],
 "accept": [
  {
   "name": "core-checks",
   "cmd": "sh tests/agent/run_core.sh",
   "timeoutS": 300,
   "must": ["re:agent core: (69[6-9]|[7-9]\\d\\d) passed, 0 failed"]
  },
  {
   "name": "android-check",
   "cmd": "sh tests/agent/android_check.sh",
   "timeoutS": 300,
   "must": ["ANDROID CHECK OK"]
  },
  {
   "name": "tv-build-and-wiring",
   "cmd": "sh tests/agent/accept_perf.sh",
   "timeoutS": 900,
   "must": ["PERF OK"]
  }
 ]
}
