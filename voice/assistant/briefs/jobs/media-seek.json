{
 "id": "media-seek",
 "title": "「快进一分钟」 is answered at once: XiaoAi has done it (PlaybackController.Seek), or 星仪 presses the fast-forward / rewind keys in 云视听极光's player",
 "brief": "briefs/media-seek.md",
 "isolation": "worktree",
 "maxRounds": 6,
 "timeoutMin": 100,
 "owns": [
  "src/xyz/erapi0neer/xingyi/agent/QuickCommand.java",
  "src/xyz/erapi0neer/xingyi/agent/PlayerPages.java",
  "src/xyz/erapi0neer/xingyi/agent/AgentLoop.java",
  "src/xyz/erapi0neer/xingyi/agent/tv/TvTools.java",
  "tests/agent/QuickChecks.java",
  "tests/agent/SkillChecks.java"
 ],
 "accept": [
  {
   "name": "core-checks",
   "cmd": "sh tests/agent/run_core.sh",
   "timeoutS": 500,
   "must": [
    "re:agent core: ([1-9]\\d{4,}|469[6-9]|4[7-9]\\d\\d|[5-9]\\d\\d\\d) passed, 0 failed"
   ]
  },
  {
   "name": "android-check",
   "cmd": "sh tests/agent/android_check.sh",
   "timeoutS": 400,
   "must": [
    "ANDROID CHECK OK"
   ]
  },
  {
   "name": "bridge",
   "cmd": "sh tests/agent/accept_media_seek.sh",
   "timeoutS": 900,
   "must": [
    "MEDIA SEEK OK"
   ]
  }
 ]
}
