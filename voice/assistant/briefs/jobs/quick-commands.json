{
 "id": "quick-commands",
 "title": "Quick commands: simple TV commands run their tool directly, without the model",
 "brief": "briefs/quick-commands.md",
 "isolation": "worktree",
 "maxRounds": 5,
 "timeoutMin": 100,
 "owns": [
  "src/xyz/erapi0neer/xingyi/agent/QuickCommand.java",
  "src/xyz/erapi0neer/xingyi/agent/tv/AgentEngine.java",
  "src/xyz/erapi0neer/xingyi/agent/tv/TvTools.java",
  "tests/agent/QuickChecks.java"
 ],
 "accept": [
  {
   "name": "core-checks",
   "cmd": "sh tests/agent/run_core.sh",
   "timeoutS": 300,
   "must": ["re:agent core: (3[2-9]\\d|[4-9]\\d\\d) passed, 0 failed"]
  },
  {
   "name": "android-check",
   "cmd": "sh tests/agent/android_check.sh",
   "timeoutS": 300,
   "must": ["ANDROID CHECK OK"]
  },
  {
   "name": "tv-build-and-wiring",
   "cmd": "sh tests/agent/accept_quick.sh",
   "timeoutS": 900,
   "must": ["QUICK OK"]
  }
 ]
}
