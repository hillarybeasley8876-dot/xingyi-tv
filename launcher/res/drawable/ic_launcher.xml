<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF000000" />
            <size android:width="320dp" android:height="180dp" />
        </shape>
    </item>
    <item android:gravity="center" android:width="96dp" android:height="96dp">
        <shape android:shape="ring" android:innerRadiusRatio="2.6" android:thicknessRatio="18" android:useLevel="false">
            <solid android:color="#FFF4F7FA" />
        </shape>
    </item>
    <item android:gravity="center" android:width="140dp" android:height="140dp">
        <shape android:shape="ring" android:innerRadiusRatio="2.3" android:thicknessRatio="40" android:useLevel="false">
            <solid android:color="#FF5F666D" />
        </shape>
    </item>
</layer-list>
